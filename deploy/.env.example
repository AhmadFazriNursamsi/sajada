# Copy to .env and replace each password, e.g. with the output of: openssl rand -hex 16
# POSTGRES_PASSWORD is only used when the data volume is first created; keep it afterwards.
POSTGRES_PASSWORD=change-me
SAJADA_API_PASSWORD=change-me
# Domain served by nginx. Pages there need the user name and password below (HTTP Basic);
# without a password the app only answers on 127.0.0.1 (SSH tunnel).
SAJADA_PUBLIC_HOSTS=sajada.devoutsys.com
SAJADA_WEB_USER=admin
SAJADA_WEB_PASSWORD=change-me
# Image tag: latest (main), or a commit tag such as sha-884f7c4 to pin a version.
SAJADA_TAG=latest
# Host port on 127.0.0.1.
APP_PORT=3000
