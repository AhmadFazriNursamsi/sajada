# Copy to .env and replace each password, e.g. with the output of: openssl rand -hex 16
# POSTGRES_PASSWORD is only used when the data volume is first created; keep it afterwards.
POSTGRES_PASSWORD=change-me
SAJADA_API_PASSWORD=change-me
# First admin account, created at start-up while no active admin exists. Its password must be
# replaced at the first sign-in; the admin then creates the other accounts in Pengaturan.
SAJADA_ADMIN_USERNAME=admin
SAJADA_ADMIN_PASSWORD=change-me
# Image tag: latest (main), or a commit tag such as sha-884f7c4 to pin a version.
SAJADA_TAG=latest
# Address and port the app listens on: 127.0.0.1 when nginx runs on this server, or this
# server's internal IP when a separate gateway proxies to it.
APP_BIND=127.0.0.1
APP_PORT=3000
